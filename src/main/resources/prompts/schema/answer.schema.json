{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/prompts/schema/answer.schema.json",
  "title": "StructuredAnswer",
  "type": "object",
  "required": ["answer"],
  "properties": {
    "answer": {"type": "string"},
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string"},
          "snippet": {"type": "string"}
        }
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "followups": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}
