#!/bin/bash
# Talisman Pre-Commit Hook (cross-platform, downloads binary on-demand)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
TALISMAN_DIR="$REPO_ROOT/tools/talisman"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"

case "$OS" in
  mingw*|msys*|cygwin*) OS="windows" ;;
esac
case "$ARCH" in
  x86_64|amd64) ARCH="amd64" ;;
  aarch64|arm64) ARCH="arm64" ;;
esac

[ "$OS" = "windows" ] && EXT=".exe" || EXT=""
BINARY="$TALISMAN_DIR/talisman_${OS}_${ARCH}${EXT}"

if [ ! -f "$BINARY" ]; then
  echo "[INFO] Downloading Talisman $OS/$ARCH binary..."
  mkdir -p "$TALISMAN_DIR"
  VERSION=$(curl -s "https://api.github.com/repos/thoughtworks/talisman/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p')
  if [ -z "$VERSION" ]; then
    VERSION="v1.37.0"
  fi
  URL="https://github.com/thoughtworks/talisman/releases/download/${VERSION}/talisman_${OS}_${ARCH}${EXT}"
  if curl -sL "$URL" -o "$BINARY" 2>/dev/null && [ -f "$BINARY" ]; then
    [ "$OS" != "windows" ] && chmod +x "$BINARY" 2>/dev/null || true
  else
    echo "[WARN] Talisman binary download failed for $OS/$ARCH. Skipping."
    rm -f "$BINARY" 2>/dev/null
    exit 0
  fi
fi

echo "Running Talisman Secret Scanner..."
"$BINARY" --githook pre-commit