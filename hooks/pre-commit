#!/bin/bash
# Betterleaks Pre-Commit Hook (cross-platform, downloads binary on-demand)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
BETTERLEAKS_DIR="$REPO_ROOT/tools/betterleaks"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m | tr '[:upper:]' '[:lower:]')"

case "$OS" in
  mingw*|msys*|cygwin*) OS="windows" ;;
  darwin*) OS="darwin" ;;
  linux*) OS="linux" ;;
  *)
    echo "[WARN] Unsupported OS for Betterleaks download: $OS. Skipping."
    exit 0
    ;;
esac
case "$ARCH" in
  x86_64|amd64) ARCH="x64" ;;
  aarch64|arm64) ARCH="arm64" ;;
  *)
    echo "[WARN] Unsupported architecture for Betterleaks download: $OS. Skipping."
    exit 0
    ;;
esac

if [ "$OS" = "windows" ]; then
  EXT=".exe"
  ARCHIVE_EXT="zip"
else
  EXT=""
  ARCHIVE_EXT="tar.gz"
fi
BINARY="$BETTERLEAKS_DIR/betterleaks${EXT}"

if [ ! -f "$BINARY" ]; then
  echo "[INFO] Downloading Betterleaks $OS/$ARCH binary..."
  mkdir -p "$BETTERLEAKS_DIR"

  TAG=$(curl -s "https://api.github.com/repos/betterleaks/betterleaks/releases/latest" 2>/dev/null | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1)
  if [ -z "$TAG" ]; then
    echo "[WARN] Unable to determine latest Betterleaks release. Skipping."
    exit 0
  fi

  VERSION="${TAG#v}"
  ASSET="betterleaks_${VERSION}_${OS}_${ARCH}.${ARCHIVE_EXT}"
  ARCHIVE="$BETTERLEAKS_DIR/$ASSET"
  URL="https://github.com/betterleaks/betterleaks/releases/download/${TAG}/${ASSET}"

  if ! curl -sL "$URL" -o "$ARCHIVE" 2>/dev/null || [ ! -s "$ARCHIVE" ]; then
    echo "[WARN] Betterleaks archive download failed for $OS/$ARCH. Skipping."
    rm -f "$ARCHIVE" 2>/dev/null
    exit 0
  fi

  if [ "$OS" = "windows" ]; then
    if ! command -v unzip >/dev/null 2>&1; then
      echo "[WARN] unzip is required to extract Betterleaks on Windows. Skipping."
      rm -f "$ARCHIVE" 2>/dev/null
      exit 0
    fi
    if ! unzip -p "$ARCHIVE" "betterleaks.exe" > "$BINARY" 2>/dev/null; then
      echo "[WARN] Failed to extract Betterleaks from $ASSET. Skipping."
      rm -f "$ARCHIVE" "$BINARY" 2>/dev/null
      exit 0
    fi
  else
    if ! command -v tar >/dev/null 2>&1; then
      echo "[WARN] tar is required to extract Betterleaks on $OS. Skipping."
      rm -f "$ARCHIVE" 2>/dev/null
      exit 0
    fi
    if ! tar -xzf "$ARCHIVE" -C "$BETTERLEAKS_DIR" "betterleaks" 2>/dev/null; then
      echo "[WARN] Failed to extract Betterleaks from $ASSET. Skipping."
      rm -f "$ARCHIVE" "$BINARY" 2>/dev/null
      exit 0
    fi
    chmod +x "$BINARY" 2>/dev/null || true
  fi

  rm -f "$ARCHIVE" 2>/dev/null
fi

# Betterleaks shells out to `git diff --staged`; force plain diff output so a
# global `color.ui = always` does not inject ANSI escapes into the patch stream.
export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0=color.ui
export GIT_CONFIG_VALUE_0=false
export GIT_CONFIG_KEY_1=color.diff
export GIT_CONFIG_VALUE_1=false

echo "Running Betterleaks Secret Scanner..."
CONFIG_ARGS=()
if [ -f "$REPO_ROOT/.betterleaks.toml" ]; then
  CONFIG_ARGS=(--config "$REPO_ROOT/.betterleaks.toml")
fi
"$BINARY" git --pre-commit --staged --no-banner --no-color --redact "${CONFIG_ARGS[@]}"
